        <mxCell id="AzcGXK2-GLpjvijxSMWe-104" value="Работа с данными о клиентах" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.125;exitY=0.997;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="AzcGXK2-GLpjvijxSMWe-78" target="AzcGXK2-GLpjvijxSMWe-49" edge="1">
